// Car Rental Agency Business Software - Database Schema
//
// SQLite has no native enum type, so enum-like fields are stored as String
// and constrained/validated at the API layer (see src/routes/*.ts Zod schemas).
// Valid values are documented in each field's comment below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("CUSTOMER") // ADMIN | STAFF | CUSTOMER
  phone         String?
  address       String?
  licenseNumber String?
  dateOfBirth   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[] @relation("CustomerBookings")

  @@map("users")
}

model Vehicle {
  id            String            @id @default(cuid())
  make          String
  model         String
  year          Int
  category      String // ECONOMY | COMPACT | SEDAN | SUV | LUXURY | VAN | TRUCK | CONVERTIBLE
  licensePlate  String            @unique
  color         String?
  seats         Int               @default(5)
  transmission  String            @default("AUTOMATIC") // AUTOMATIC | MANUAL
  fuelType      String            @default("PETROL") // PETROL | DIESEL | HYBRID | ELECTRIC
  dailyRate     Float
  mileage       Int               @default(0)
  status        String            @default("AVAILABLE") // AVAILABLE | RENTED | MAINTENANCE | RETIRED
  imageUrl      String?
  description   String?
  features      String? // comma-separated feature list
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  bookings      Booking[]
  maintenance   MaintenanceRecord[]

  @@map("vehicles")
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  startDate       DateTime
  endDate         DateTime
  pickupLocation  String
  dropoffLocation String
  status          String        @default("PENDING") // PENDING | CONFIRMED | ACTIVE | COMPLETED | CANCELLED
  dailyRate       Float
  totalAmount     Float
  notes           String?
  actualPickupAt  DateTime?
  actualReturnAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments        Payment[]

  @@map("bookings")
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Float
  method          String        @default("CARD") // CASH | CARD | BANK_TRANSFER | ONLINE
  status          String        @default("PENDING") // PENDING | PAID | REFUNDED | FAILED
  transactionRef  String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

model MaintenanceRecord {
  id          String            @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  type        String            @default("SERVICE") // SERVICE | REPAIR | INSPECTION | CLEANING | TIRE_CHANGE | OTHER
  description String
  cost        Float             @default(0)
  startDate   DateTime
  endDate     DateTime?
  status      String            @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("maintenance_records")
}
